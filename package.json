{
  "name": "@mp-consulting/homebridge-philips-ambilight-tv",
  "displayName": "Philips Ambilight TV",
  "type": "module",
  "version": "1.9.0",
  "description": "Homebridge plugin to control Philips Ambilight TV as a HomeKit Television accessory.",
  "author": "Mickael Palma",
  "license": "(Apache-2.0 AND MIT)",
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "homepage": "https://github.com/mp-consulting/homebridge-philips-ambilight-tv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-philips-ambilight-tv.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-philips-ambilight-tv/issues"
  },
  "keywords": [
    "ambilight",
    "android",
    "homebridge-plugin",
    "philips",
    "television",
    "tv"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "copy:ui-assets": "mp-ui-kit-copy --vendor",
    "build": "npm run copy:ui-assets && rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "start": "npm run build && homebridge -U ./test/hbConfig -D -P .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tv": "npm run build && node test/test-tv-endpoints.js"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "@mp-consulting/homebridge-ai-core": "^2.0.0",
    "bonjour-service": "^1.4.4",
    "class-validator": "^0.15.1",
    "node-arp": "^1.0.6",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mp-consulting/homebridge-ui-kit": "^1.2.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.12.0",
    "homebridge": "^2.4.0",
    "homebridge-config-ui-x": "^5.29.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@nestjs/platform-fastify": "^12.1.2",
    "fastify": "^5.12.5"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ]
}
